STORYBLOK_PERSONAL_ACCESS_TOKEN=

# URL de la Azure Function que emite el SAS token (ver ../sas-token-function)
VITE_SAS_TOKEN_ENDPOINT=http://localhost:7071/api/sas-token

# Debe coincidir con PLUGIN_SHARED_SECRET en sas-token-function/local.settings.json
# Nota: esto termina en el bundle del navegador, no es un secreto fuerte — ver README.
VITE_PLUGIN_SHARED_SECRET=

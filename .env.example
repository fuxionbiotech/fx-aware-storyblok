STORYBLOK_DELIVERY_API_TOKEN=<REPLACE_WITH_YOUR_TOKEN>
STORYBLOK_API_BASE_URL=https://api.storyblok.com
STORYBLOK_REGION=<REPLACE_WITH_SPACE_REGION>

# Azure Blob Storage — usado por /api/sas-token (subida del Field Plugin azure-asset-upload)
AZURE_STORAGE_ACCOUNT_NAME=<nombre de la storage account>
AZURE_STORAGE_ACCOUNT_KEY=<account key — nunca commitear el valor real>
AZURE_STORAGE_CONTAINER_NAME=<contenedor destino, ej. media>
PLUGIN_SHARED_SECRET=<debe coincidir con VITE_PLUGIN_SHARED_SECRET del plugin>
ALLOWED_ORIGIN=<origin permitido por CORS, ej. https://plugin-sandbox.storyblok.com>
